# ================= Telegram AI Agent — muhit o'zgaruvchilari =================
# Nusxa oling:  cp .env.example .env
# So'ng qiymatlarni to'ldiring. .env fayli HECH QACHON git'ga tushmasligi kerak.

# --------------------------------- Ilova ------------------------------------
APP_NAME="Telegram AI Agent"
APP_VERSION="0.1.0"
ENVIRONMENT=local            # local | development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Vergul bilan ajratilgan domenlar yoki * (barchasi)
CORS_ORIGINS=*

# ------------------------------ Deploy (VPS) --------------------------------
DOMAIN=example.com            # domeningiz (DNS A-yozuvi VPS IP'ga yo'naltirilsin)
ACME_EMAIL=admin@example.com  # Let's Encrypt bildirishnomalari uchun
RUN_MIGRATIONS=0              # konteyner startida migratsiya (Alembic sozlangach: 1)
FLOWER_BASIC_AUTH=admin:CHANGE_ME  # Flower monitoring paneli logini (user:parol)

# ------------------------------ Xavfsizlik ----------------------------------
# JWT imzo kaliti — yarating:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
# Fernet shifrlash kaliti (api_hash / session_string uchun) — yarating:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_fernet_key_base64_32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# ------------------------------- PostgreSQL ---------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tgagent
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=tgagent
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --------------------------------- Redis ------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2

# ------------------------- Claude (asosiy AI) -------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8       # arzonroq: claude-sonnet-5 yoki claude-haiku-4-5
CLAUDE_MAX_TOKENS=2048
AI_TEMPERATURE=0.7                 # faqat fallback uchun (Claude qabul qilmaydi)
AI_REQUEST_TIMEOUT=60             # AI so'rovi osilib qolmasin (soniya)

# ----------------------- AI fallback (OpenAI / Gemini) ----------------------
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# -------------------------------- Image AI ----------------------------------
IMAGE_PROVIDER=openai         # openai | stable_diffusion | replicate
OPENAI_API_KEY=               # DALL·E uchun (matn fallback bilan bir xil kalit)
MEDIA_STORAGE_DIR=/app/media
MEDIA_RETENTION_DAYS=7        # eski rasmlar shu kundan keyin o'chiriladi
IMAGE_SIZE=1024x1024
DALLE_MODEL=dall-e-3
# Lokal Stable Diffusion (Automatic1111): http://stable-diffusion:7860
SD_API_URL=
SD_STEPS=30
# Replicate (ixtiyoriy)
REPLICATE_API_TOKEN=
REPLICATE_MODEL=

# -------------------------------- Telegram ----------------------------------
TELEGRAM_PUBLISH_MODE=telethon   # telethon | bot_api
# my.telegram.org dan olinadi (Telethon userbot uchun)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# @BotFather dan olinadi (bot_api rejimi + admin panel uchun)
TELEGRAM_BOT_TOKEN=
# Admin panel FAQAT shu Telegram user ID orqali ishlaydi (@userinfobot dan oling)
ADMIN_TELEGRAM_ID=
# Akkaunt bloklanmasligi uchun himoya
MIN_DELAY_BETWEEN_POSTS=30       # soniya
MAX_DELAY_BETWEEN_POSTS=90       # soniya
DAILY_POST_LIMIT=50

# ------------------------------- Yangiliklar --------------------------------
NEWS_LOOKBACK_HOURS=24
NEWS_MAX_ITEMS=5
NEWS_REQUEST_TIMEOUT=15
