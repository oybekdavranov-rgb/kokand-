# Nusxa oling:  cp .env.example .env   (yoki hosting panelida shu qiymatlarni kiriting)
# =====================================================================

# --- Admin parol (BITTASINI tanlang) ---
# Tavsiya etiladi: HASH (parol ochiq saqlanmaydi). Yaratish:  npm run hash-password -- "kuchli-parol"
# ADMIN_PASSWORD_HASH=scrypt$16384$...$...
#
# Yoki oddiy (ochiq) parol — faqat sinov uchun:
ADMIN_PASSWORD=change-me-please

# --- Token imzo kaliti (MAJBURIY, uzun tasodifiy satr) ---
# Yaratish:  npm run gen-secret
JWT_SECRET=change-me-to-a-long-random-string

# --- Muhit ---
NODE_ENV=production
PORT=3000

# --- Ma'lumot ombori ---
# (a) Fayl rejimi (standart). Doimiy disk kerak (aks holda deploy'da o'chadi):
# DATA_FILE=/data/ku.json
# ANALYTICS_FILE=/data/ku-analytics.json
#
# (b) PostgreSQL rejimi (Railway tavsiya etiladi). Shu o'rnatilsa avtomatik ishlatiladi:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# PGSSL=disable          # faqat SSL kerak bo'lmasa

# --- Ixtiyoriy ---
# TOKEN_TTL_HOURS=720    # token amal qilish muddati (soat). Standart: 720 (30 kun)
# DATA_LIMIT=30mb        # admin saqlash uchun body limiti
