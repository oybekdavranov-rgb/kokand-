# =====================================================================
#  Murojaat boti — sozlamalar namunasi
#  Nusxa olish:  cp .env.example .env   (yoki:  npm run setup)
#  .env faylini GIT'ga qo'shmang va hech kimga yubormang!
# =====================================================================

# development | production  (production'da zaif parol/kalitlar rad etiladi)
NODE_ENV=production

# ----------------------------- TELEGRAM ------------------------------
# @BotFather bergan token
BOT_TOKEN=

# polling  — hech qanday domen kerak emas, hoziroq ishlaydi (tavsiya: boshlash uchun)
# webhook  — HTTPS domen kerak, tezroq va kam resurs ishlatadi (tavsiya: doimiy ish uchun)
BOT_MODE=polling

# Yangi murojaat haqida xabar keladigan Telegram chat ID'lari (vergul bilan).
# O'z ID'ingizni bilish uchun botga /start yozib, logdan ko'rishingiz mumkin,
# yoki @userinfobot ga yozing. Guruh ID'si manfiy bo'ladi: -1001234567890
# Shu chatda xabarnomaga "reply" qilib to'g'ridan-to'g'ri javob yozish mumkin
# (dekanning SHAXSIY chati ham, dekanat guruhi ham bo'lishi mumkin).
# Qo'shimcha buyruqlar: /javob MR-2026-0007 <matn>  va  /statistika
NOTIFY_CHAT_IDS=

# ------------------------------- WEB ---------------------------------
PORT=8080

# Panel QAYSI manzilda tinglaydi.
#   127.0.0.1 — faqat shu server (oldida nginx turadi) — TAVSIYA ETILADI
#   0.0.0.0   — barcha tarmoq interfeyslari (faqat Docker ichida yoki
#               oldida xavfsizlik devori bo'lsa)
HOST=127.0.0.1

# Panelning tashqi manzili (webhook rejimi uchun majburiy)
PUBLIC_URL=

# Reverse-proxy (nginx) ortida ishlaganda KIMGA ishonish mumkinligi:
#   loopback        — nginx shu serverda (eng keng tarqalgan holat)
#   10.0.0.5        — proksi boshqa serverda bo'lsa, uning IP manzili
#   (bo'sh)         — proksi yo'q, to'g'ridan-to'g'ri ishlaydi
# DIQQAT: "1" kabi raqam yozmang — u holda mijoz X-Forwarded-For/Proto
# sarlavhalarini soxtalashtirib, HTTPS majburiyligi va so'rov chegaralarini
# aylanib o'tishi mumkin.
TRUST_PROXY=loopback

# HTTPS majburiy bo'lsin (production uchun: true)
REQUIRE_HTTPS=true

# --------------------------- MAXFIY KALITLAR -------------------------
# Har bir o'rnatish uchun YANGI tasodifiy kalit yarating:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Webhook rejimi uchun (kamida 24 belgi). Telegram shu kalitni har so'rovda yuboradi.
WEBHOOK_SECRET=

# ------------------------------ ADMIN --------------------------------
ADMIN_USERNAME=admin

# TAVSIYA: parolni hash ko'rinishida saqlang —  npm run hash -- "ParolingizBuYerda"
ADMIN_PASSWORD_HASH=

# Yoki (faqat qulaylik uchun) ochiq parol: birinchi ishga tushishda bazaga
# hash qilib yoziladi, keyin bu qatorni o'chirib tashlang. Kamida 12 belgi.
# ADMIN_PASSWORD=

# Sessiya muddati
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=90

# Kirishni qulflash: 15 daqiqada 8 marta xato urinishdan keyin
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# -------------------------- MUROJAAT QOIDALARI -----------------------
# Kategoriya YO'Q — foydalanuvchi xohlagan narsasini yozadi.
# Bu yerda faqat hajm va spamga qarshi chegaralar bor.
APPEAL_MIN_LENGTH=12
APPEAL_MAX_LENGTH=3500
APPEALS_PER_HOUR=4
APPEALS_PER_DAY=12
APPEAL_COOLDOWN_SECONDS=20
MAX_ATTACHMENTS_PER_APPEAL=10
MAX_ATTACHMENT_MB=20

# ------------------------- NAZORAT VA XULOSA -------------------------
# Shu muddatdan oshgan javobsiz murojaat "kechikkan" deb belgilanadi
SLA_HOURS=48

# Kunlik xulosa (javobsiz murojaatlar ro'yxati) necha soatda yuborilsin
DIGEST_HOUR=9

# Mahalliy vaqt farqi (O'zbekiston: UTC+5)
TZ_OFFSET_HOURS=5

# Murojaat "Ko'rib chiqilmoqda"ga o'tganda muallifga xabar berilsinmi
NOTIFY_USER_ON_PROGRESS=true

# ---------------------------- MA'LUMOTLAR ----------------------------
# Baza va zaxiralar shu papkada saqlanadi (doimiy disk bo'lsin!)
DATA_DIR=./data

# ------------------------ FAKULTET MA'LUMOTLARI ----------------------
FACULTY_NAME=Qo'qon universiteti Ta'lim fakulteti
DEAN_NAME=Xursanaliyev Boburmirzo Farhod o'g'li
DEAN_TITLE=dekan
OFFICE_HOURS=Dushanba–Shanba, 09:00–17:00

# ------------------------------- LOG ---------------------------------
LOG_LEVEL=info
