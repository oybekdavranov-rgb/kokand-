# =====================================================================
#  Murojaat boti — sozlamalar namunasi
#  Nusxa olish:  cp .env.example .env
#  Replit'da: .env SHART EMAS — qiymatlarni 🔒 Secrets bo'limiga yozing.
#  Bu faylni GIT'ga qo'shmang!
# =====================================================================

# development | production
NODE_ENV=production

# ----------------------------- MAJBURIY ------------------------------
# @BotFather bergan token
BOT_TOKEN=

# Murojaatlar QAYSI CHATGA yuborilsin (vergul bilan bir nechta bo'lishi mumkin).
#   • dekanning shaxsiy chati:  123456789
#   • dekanat guruhi:           -1001234567890
# O'z ID'ingizni bilish uchun Telegram'da @userinfobot ga /start yozing.
# Guruhdan foydalansangiz, botni guruhga qo'shing (admin qilish shart emas:
# kartaga qilingan «reply» botga maxfiylik rejimida ham yetadi).
ADMIN_CHAT_IDS=

# ---------------------------- IXTIYORIY ------------------------------
# Kim javob bera oladi va tugmalarni bosa oladi (Telegram user ID).
# Bo'sh qoldirilsa — admin chatidagi HAMMA. Guruh ishlatsangiz to'ldiring!
ADMIN_USER_IDS=

# polling — hech qanday domen kerak emas (tavsiya etiladi)
# webhook — HTTPS domen kerak, tezroq
BOT_MODE=polling

# Webhook uchun (BOT_MODE=webhook bo'lsa)
WEBHOOK_SECRET=
PUBLIC_URL=

# Holat tekshiruvi (/healthz) va webhook uchun port
PORT=8080
HOST=127.0.0.1

# -------------------------- MUROJAAT QOIDALARI -----------------------
# Kategoriya YO'Q — foydalanuvchi xohlagan narsasini yozadi.
APPEAL_MIN_LENGTH=12
APPEAL_MAX_LENGTH=3500
APPEALS_PER_HOUR=4
APPEALS_PER_DAY=12
APPEAL_COOLDOWN_SECONDS=20
MAX_ATTACHMENTS_PER_APPEAL=10
MAX_ATTACHMENT_MB=20

# ------------------------- NAZORAT VA XULOSA -------------------------
# Shu muddatdan oshgan javobsiz murojaat "kechikkan" deb belgilanadi
SLA_HOURS=48
# Kunlik xulosa (javobsiz murojaatlar ro'yxati) necha soatda yuborilsin
DIGEST_HOUR=9
# Mahalliy vaqt farqi (O'zbekiston: UTC+5)
TZ_OFFSET_HOURS=5
# Murojaat "Ko'rib chiqilmoqda"ga o'tganda muallifga xabar berilsinmi
NOTIFY_USER_ON_PROGRESS=true

# -------------------- ZAXIRA VA DOIMIY SAQLASH -----------------------
# Bazani Telegram'ga fayl qilib yuborish.
# DIQQAT: bazada fuqarolarning ismi, telefon raqami va murojaat matnlari bor,
# shuning uchun zaxira faqat SHAXSIY chatga yuboriladi (guruhga — yo'q).
BACKUP_TO_TELEGRAM=true
BACKUP_HOURS=24
# BACKUP_CHAT_ID=        # zaxira keladigan shaxsiy chat ID'si (tavsiya etiladi)
# BACKUP_ALLOW_GROUP=false   # true qilsangiz guruhga ham yuboriladi (tavsiya etilmaydi)

# Fayl tizimi saqlanmaydigan muhitlar (Replit) uchun:
#   replit — Replit App Storage      local — mahalliy papka      off — o'chirilgan
# Replit'da avtomatik "replit" bo'ladi, VPS'da "off" (u yerda disk doimiy).
# STORAGE_MODE=off
# STORAGE_DIR=
# SNAPSHOT_MINUTES=2

# ---------------------------- MA'LUMOTLAR ----------------------------
DATA_DIR=./data

# ------------------------ FAKULTET MA'LUMOTLARI ----------------------
FACULTY_NAME=Qo'qon universiteti Ta'lim fakulteti
DEAN_NAME=Xursanaliyev Boburmirzo Farhod o'g'li
DEAN_TITLE=dekan
OFFICE_HOURS=Dushanba–Shanba, 09:00–17:00

LOG_LEVEL=info
